# Copy to .env (git-ignored) and replace every value. Example values only — never commit real secrets.

# --- Runtime ---
APP_ENV=dev
SPRING_PROFILES_ACTIVE=dev

# --- Database (backend run directly on the host) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/shopflow
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me
# Integration tests use this database and clean it on every run (optional; Testcontainers is used when unset).
TEST_DATABASE_URL=jdbc:postgresql://localhost:5432/shopflow_test

# --- Database (podman compose) ---
POSTGRES_USER=shopflow
POSTGRES_PASSWORD=change-me

# --- Security (at least 32 random characters each; generate with: openssl rand -base64 48) ---
JWT_ACCESS_SECRET=replace-with-a-long-random-value-000000000000
JWT_REFRESH_SECRET=replace-with-another-long-random-value-0000000
OTP_HASH_SECRET=replace-with-a-random-value-000000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
REFRESH_COOKIE_SECURE=false

# --- OTP provider (mock in development) ---
OTP_PROVIDER=mock
OTP_PROVIDER_URL=
OTP_PROVIDER_KEY=

# --- WhatsApp (mock in development) ---
WHATSAPP_PROVIDER=mock
WHATSAPP_PROVIDER_URL=
WHATSAPP_PROVIDER_TOKEN=
WHATSAPP_WEBHOOK_SECRET=replace-with-a-random-value-000000

# --- Payment gateway (mock in development) ---
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_URL=
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=replace-with-a-random-value-000000

# --- E-invoice (mock; enable only if legally applicable) ---
EINVOICE_PROVIDER=mock
EINVOICE_ENABLED=false

# --- Object storage (local directory in development) ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./data/storage
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
